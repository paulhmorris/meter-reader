# Deployment configuration. Copy to .env beside compose.yaml on the host and fill in.
# Compose builds DATABASE_URL from POSTGRES_PASSWORD, so there is no connection string to keep in sync.

# Postgres password for the meter user, inside the compose network only.
# Compose builds DATABASE_URL around it, so keep it alphanumeric — openssl rand -hex 32.
# A base64 password would carry / or + and Prisma would read the connection string wrong.
POSTGRES_PASSWORD=""

# Where neighbours reach the app, exactly as the browser sees it. adapter-node rejects
# form posts from any other origin, so a mismatch here breaks claiming and Admin sign-in.
ORIGIN="https://meter.example.com"

# Connector token from the Cloudflare Zero Trust dashboard, for the tunnel that serves ORIGIN.
TUNNEL_TOKEN=""

# Where the app listens for a reverse proxy on the LAN, host side. Loopback keeps it
# off the network; give it a LAN address to let a proxy on another machine reach it.
WEB_BIND="127.0.0.1:3010"

# Signs the Grant and Admin cookies: openssl rand -base64 32. Changing it signs everyone out.
GRANT_SECRET=""

# What the Admin signs in with at /admin. Blank and the Admin surface admits nobody.
ADMIN_PASSWORD=""

# The Home Assistant broker. An address, not homeassistant.local: containers do not resolve mDNS.
MQTT_URL="mqtt://192.168.1.10:1883"
MQTT_TOPIC="rtl_433/raspberrypi/devices/Neptune-R900"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# Sentry. Both processes report with environment "production", set by compose.
SENTRY_DSN=""
PUBLIC_SENTRY_DSN=""
