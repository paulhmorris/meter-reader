# Postgres connection string, used by the app, the ingest service and Prisma migrations.
# Prisma needs an explicit user; it does not fall back to the OS user the way libpq does.
DATABASE_URL="postgresql://paul@localhost:5432/meter-reader?schema=public"

# Signs the Grant and Admin cookies: any long random string, e.g. openssl rand -base64 32.
GRANT_SECRET=""

# What the Admin signs in with at /admin. Leave blank and nobody can reach the Admin surface.
ADMIN_PASSWORD=""

# Sentry. Leave blank to disable reporting locally.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
PUBLIC_SENTRY_DSN=""
PUBLIC_SENTRY_ENVIRONMENT="development"
