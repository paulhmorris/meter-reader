generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A physical Neptune R900 water meter, identified by the 32-bit id in its radio transmission.
model Meter {
  id         BigInt       @id
  createdAt  DateTime     @default(now())
  readings   Reading[]
  events     MeterEvent[]
  claimCodes ClaimCode[]
  grants     Grant[]
}

/// One decoded R900 transmission from a Meter, with the time it was received.
model Reading {
  id          BigInt   @id @default(autoincrement())
  meterId     BigInt
  meter       Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  /// The Meter's lifetime cumulative total in gallons.
  consumption Decimal  @db.Decimal(12, 1)
  /// 0 none, 1 intermittent, 2 continuous — the meter's rolling 24-hour leak assessment.
  activeLeak  Int      @db.SmallInt
  /// Days on which a leak was seen, bucketed 0-6, never an exact number of days.
  leakHistory Int      @db.SmallInt
  backflow    Int      @db.SmallInt
  noUse       Int      @db.SmallInt
  receivedAt  DateTime

  @@index([meterId, receivedAt])
}

/// The Meter flags whose transitions are recorded, Leak History excluded as it is a bucket rather than a state.
enum MeterEventFlag {
  activeLeak
  backflow
  noUse
}

/// A recorded transition of one of the Meter's flags from one value to another. Kept forever, never pruned (ADR-0003).
model MeterEvent {
  id         BigInt         @id @default(autoincrement())
  meterId    BigInt
  meter      Meter          @relation(fields: [meterId], references: [id], onDelete: Cascade)
  flag       MeterEventFlag
  from       Int            @db.SmallInt
  to         Int            @db.SmallInt
  occurredAt DateTime

  @@index([meterId, occurredAt])
}

/// A secret string that names exactly one Meter and proves the holder is entitled to see it.
model ClaimCode {
  code      String    @id
  meterId   BigInt
  meter     Meter     @relation(fields: [meterId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  /// Set when the Admin rotates the code, which stops it claiming without touching existing Grants.
  rotatedAt DateTime?
  grants    Grant[]

  @@index([meterId])
}

/// One device's access to one Meter, created by a Claim and held as a signed cookie.
model Grant {
  id        String     @id @default(uuid(7))
  meterId   BigInt
  meter     Meter      @relation(fields: [meterId], references: [id], onDelete: Cascade)
  claimCode String?
  claim     ClaimCode? @relation(fields: [claimCode], references: [code], onDelete: SetNull)
  createdAt DateTime   @default(now())
  /// What the device called itself when it claimed, so the Admin can tell two devices apart.
  device    String?
  /// Set when the Admin revokes this one device's access.
  revokedAt DateTime?
  pushEndpoints PushEndpoint[]

  @@index([meterId])
}

/// A browser's address for pushing to one device, with the keys that encrypt to it. Held against a Grant, so revoking the Grant silences it.
model PushEndpoint {
  id        String   @id @default(uuid(7))
  grantId   String
  grant     Grant    @relation(fields: [grantId], references: [id], onDelete: Cascade)
  /// The URL the browser's push service issued. A browser issues one per origin, so a device holding two Grants warns on both through the same endpoint.
  endpoint  String
  /// The device's public key and auth secret, which the payload is encrypted to.
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  /// One row per Grant per device, so re-enabling warnings replaces the row rather than collecting them.
  @@unique([grantId, endpoint])
  @@index([grantId])
}
