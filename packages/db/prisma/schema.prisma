generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A physical Neptune R900 water meter, identified by the 32-bit id in its radio transmission.
model Meter {
  id         BigInt      @id
  createdAt  DateTime    @default(now())
  readings   Reading[]
  claimCodes ClaimCode[]
  grants     Grant[]
}

/// One decoded R900 transmission from a Meter, with the time it was received.
model Reading {
  id          BigInt   @id @default(autoincrement())
  meterId     BigInt
  meter       Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  /// The Meter's lifetime cumulative total in gallons.
  consumption Decimal  @db.Decimal(12, 1)
  /// 0 none, 1 intermittent, 2 continuous — the meter's rolling 24-hour leak assessment.
  activeLeak  Int      @db.SmallInt
  /// Days on which a leak was seen, bucketed 0-6, never an exact number of days.
  leakHistory Int      @db.SmallInt
  backflow    Int      @db.SmallInt
  noUse       Int      @db.SmallInt
  receivedAt  DateTime

  @@index([meterId, receivedAt])
}

/// A secret string that names exactly one Meter and proves the holder is entitled to see it.
model ClaimCode {
  code      String    @id
  meterId   BigInt
  meter     Meter     @relation(fields: [meterId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  /// Set when the Admin rotates the code, which stops it claiming without touching existing Grants.
  rotatedAt DateTime?
  grants    Grant[]

  @@index([meterId])
}

/// One device's access to one Meter, created by a Claim and held as a signed cookie.
model Grant {
  id        String     @id @default(uuid(7))
  meterId   BigInt
  meter     Meter      @relation(fields: [meterId], references: [id], onDelete: Cascade)
  claimCode String?
  claim     ClaimCode? @relation(fields: [claimCode], references: [code], onDelete: SetNull)
  createdAt DateTime   @default(now())
  /// Set when the Admin revokes this one device's access.
  revokedAt DateTime?

  @@index([meterId])
}
